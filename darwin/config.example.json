{
  "gemini": {
    "api_base": "https://generativelanguage.googleapis.com/v1beta",
    "model": "gemini-3.8-flash-tts",
    "voice": "Charon",
    "style_mode": "metadata",
    "base_style": "NHKの自然ドキュメンタリー番組のベテラン男性ナレーター。真面目で落ち着いた声、ゆったりした間。どんなに滑稽な内容でも大真面目に読む。",
    "emotions": {
      "穏やか": "穏やかで柔らかく、雄大な自然を紹介するように",
      "発見": "小声で、息をひそめて獲物を見つけた瞬間のように",
      "興奮": "やや声を張り、興奮を抑えきれない様子で",
      "解説": "淡々と、学術的に解説するように",
      "落胆": "ため息まじりに、がっかりした様子で",
      "哀愁": "しみじみと、哀れみを込めてゆっくりと",
      "緊張": "声を落とし、緊張感を持って間を取りながら",
      "期待": "少し身を乗り出すように、期待を込めて",
      "感動": "感動的に、敬意を込めて、ゆっくりと締めくくるように"
    },
    "line_gap": 0.3,
    "section_head": 0.2,
    "section_tail": 0.4
  },
  "comfy": {
    "url": "http://127.0.0.1:8188",
    "workflow": "comfy/h3_i2v_api.json",
    "fps": 24,
    "length_base": 5,
    "length_step": 17,
    "width": 736,
    "height": 1280,
    "min_seconds": 4,
    "max_seconds": 15,
    "timeout_sec": 3600,
    "nodes": {
      "image":    {"node": "REPLACE_ME", "input": "image"},
      "prompt":   {"node": "REPLACE_ME", "input": "text"},
      "negative": {"node": "REPLACE_ME", "input": "text"},
      "duration": {"node": "REPLACE_ME", "input": "length", "unit": "frames"},
      "seed":     {"node": "REPLACE_ME", "input": "seed"},
      "width":    {"node": "", "input": "width"},
      "height":   {"node": "", "input": "height"}
    }
  },
  "render": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "ambience_volume": 0.18,
    "use_clip_audio_as_ambience": true,
    "sfx_volume": 0.9,
    "bgm_volume": 0.45,
    "bgm_fade_in": 0.8,
    "fade_out": 1.2,
    "loudness_lufs": -14
  }
}
