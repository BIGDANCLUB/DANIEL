// ============================================================
// Config.tjs - ティラノスクリプト V6 標準設定
// ============================================================

// ゲームタイトル
var title = "勇者と魔王城の淫紋";

// バージョン
var version = "1.0.0";

// 最初に読み込むシナリオ
var first_scenario = "first.ks";

// ウィンドウサイズ
var window_width = 1280;
var window_height = 720;

// フルスクリーン初期設定
var full_screen = false;

// テキスト設定
var defaultTextColor = "white";
var defaultTextSize = 26;
var defaultTextSpeed = 40;
var defaultAutoSpeed = 2000;

// 音量初期値 (0-100)
var defaultBgmVolume = 80;
var defaultSeVolume = 80;
var defaultVoiceVolume = 100;

// セーブスロット数
var save_slot = 20;

// バックログ最大行数
var backlog_max = 200;

// 未読スキップ禁止
var skip_unread = false;

// 年齢確認
var age_check = true;
