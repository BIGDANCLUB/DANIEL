// Config.tjs - ティラノスクリプト V6 設定
// Copyright (C) 2012-2021 ShikemokuMK

;global.config_version = "6.00"; // この行を消さないでください

// ゲームタイトル
;System.title = "勇者と魔王城の淫紋";

// プロジェクトID
;projectID = tyranoproject;

// リリースバージョン
;game_version = 1.0;

// 画面サイズ
;scWidth = 1280;
;scHeight = 720;

// 画面比率
;ScreenRatio = fix;

// 3D機能（不要なのでfalse）
;use3D = false;

// テキスト表示スピード（ミリ秒/文字）
;chSpeed = 30;
;chSpeeds.fast = 10;
;chSpeeds.normal = 30;
;chSpeeds.slow = 50;

// テキストアニメーション効果
;defaultChEffect = none;

// スキップスピード
;skipSpeed = 0;
;skipEffectIgnore = true;

// オートスピード
;autoSpeed = 1300;
;autoClickStop = true;
;autoSpeedWithText = 60;

// BGM・SE音量（0〜100）
;defaultBgmVolume = 80;
;defaultSeVolume = 80;
;defaultMovieVolume = 100;

// サウンドスロット数
;defaultBgmSlotNum = 1;
;defaultSoundSlotNum = 3;

// セーブ設定
;configSave = webstorage;
;configSaveSlotNum = 20;
;configThumbnail = true;
;configThumbnailQuality = middle;
;configThumbnailScale = 0.3;
;configSaveDateFormat = yyyy/M/d h:mm:ss;

// バックログ
;maxBackLogNum = 200;

// 既読スキップ
;autoRecordLabel = false;
;unReadTextSkip = false;
;alreadyReadTextColor = 0x87cefa;

// キャラクターレイヤー数
;numCharacterLayers = 3;

// メッセージレイヤー数
;numMessageLayers = 2;
;initialMessageLayerVisible = true;

// マージン
;marginL = 8;
;marginT = 8;
;marginR = 8;
;marginB = 8;

// メッセージウィンドウ位置（画面下部）
;ml = 16;
;mt = 530;
;mw = 1248;
;mh = 170;

// メッセージレイヤー色・透明度
;frameColor = 0x000000;
;frameOpacity = 128;

// テキストフォントサイズ
;defaultFontSize = 28;

// テキスト色（0xRRGGBB形式）
;defaultChColor = 0xffffff;

// 行間・字間
;defaultLineSpacing = 8;
;defaultPitch = 0;

// フォント
;userFace = "Yu Gothic", YuGothic, Meiryo, sans-serif;

// ボールド
;defaultBold = false;

// アンチエイリアス（0:無効 1:弱め 2:強め）
;defaultAntialiased = 1;

// 影
;defaultShadow = false;
;defaultShadowColor = 0x000000;

// デバッグメニュー（リリース時はfalseに）
;debugMenu.visible = true;

// 自動改行
;defaultAutoReturn = true;
