# Hyperliquid Grid Bot Environment Variables
# Copy this file to .env and fill in your values

# Your MAIN wallet public address (not API wallet)
ACCOUNT_ADDRESS=0xYOUR_MAIN_WALLET_ADDRESS_HERE

# Your API wallet private key (generated at https://app.hyperliquid.xyz/API)
# For testnet: generate at https://app.hyperliquid-testnet.xyz/API
SECRET_KEY=0xYOUR_API_WALLET_PRIVATE_KEY_HERE

# Network: "testnet" or "mainnet"
NETWORK=testnet
