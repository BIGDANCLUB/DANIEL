    {
      "scene": 0,
      "audio": [
        3.68,
        7.12
      ],
      "text": "私の年金は\n月に{11万円}だけです",
      "src_line": 1
    },
    {
      "scene": 0,
      "audio": [
        7.28,
        10.23
      ],
      "text": "足りない<8万円>は\n貯金で払います",
      "src_line": 2
    },
    {
      "scene": 0,
      "audio": [
        10.42,
        13.72
      ],
      "text": "私は佐藤敬子\n72歳です",
      "src_line": 3
    },
    {
      "scene": 0,
      "audio": [
        43.79,
        46.89
      ],
      "text": "貯金は残り\n<80万円>になりました",
      "badge": {
        "text": "貯金残高 80万円",
        "color": "#d7263d"
      },
      "src_line": 13
    },
    {
      "scene": 0,
      "audio": [
        47.07,
        49.37
      ],
      "text": "あと<10か月>で\n底をつきます",
      "src_line": 14
    },
    {
      "scene": 0,
      "audio": [
        55.78,
        58.92
      ],
      "text": "夜、何度も\n通帳を数え直しました",
      "src_line": 17
    },
    {
      "scene": 1,
      "audio": [
        64.46,
        67.2
      ],
      "text": "ある日\n市役所へ相談に行きました",
      "src_line": 20
    },
    {
      "scene": 1,
      "audio": [
        70.89,
        73.53
      ],
      "text": "「これは{戻せますよ}」\nと言われました",
      "src_line": 22
    },
    {
      "scene": 1,
      "audio": [
        73.71,
        76.7
      ],
      "text": "{高額介護サービス費}\nという制度です",
      "src_line": 23
    },
    {
      "scene": 1,
      "audio": [
        76.84,
        80.19
      ],
      "text": "介護サービスの自己負担には\n{上限}があります",
      "src_line": 24
    },
    {
      "scene": 1,
      "audio": [
        90.17,
        93.05
      ],
      "text": "超えた分は\n{申請すれば戻る}そうです",
      "src_line": 28
    },
    {
      "scene": 1,
      "audio": [
        95.62,
        98.18
      ],
      "text": "{2年分}をまとめて\n申請できました",
      "src_line": 30
    },
    {
      "scene": 1,
      "audio": [
        100.73,
        103.6
      ],
      "text": "{24万円}が\n口座に戻ってきました",
      "badge": {
        "text": "+24万円 戻った！",
        "color": "#1f9d55"
      },
      "src_line": 32
    },
    {
      "scene": 1,
      "audio": [
        103.78,
        107.06
      ],
      "text": "これからは毎月\n{1万円}ほど戻ります",
